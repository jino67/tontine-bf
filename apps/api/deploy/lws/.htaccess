# ==========================================================================
# Racine de htdocs/<domaine>, chez LWS
# --------------------------------------------------------------------------
# Meme montage qu'amicalclinic et sunset-tour : le dossier du domaine sert de
# dossier public, l'API Laravel vit dans tontine-api/, que ce fichier interdit
# au web.
#
# APRES LA MISE EN LIGNE, ces adresses doivent repondre 403 ou 404, jamais un
# contenu :
#   https://<domaine>/tontine-api/.env
#   https://<domaine>/tontine-api/database/database.sqlite
# ==========================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteBase /

    # Bloque l'acces au code source, a la base et au .env.
    RewriteRule ^tontine-api/ - [F,L]

    # En-tete d'autorisation : indispensable, l'API authentifie par jeton.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # En-tete X-XSRF-Token
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirection des slashs finaux
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Redirection globale vers index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Ceinture et bretelles, hors du bloc de reecriture : meme si elle venait a
# manquer, le .env, la base, les journaux, les archives et les notes
# d'installation ne sont jamais servis.
<FilesMatch "(^\.env|\.sqlite$|\.log$|\.zip$|^LISEZ-MOI)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
</IfModule>
